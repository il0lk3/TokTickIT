// Prisma schema — datasource and generator are pre-wired.
// Your DATABASE_URL lives in server/.env (copy it from .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
// 1. User Model
model User {
  id                 Int      @id @default(autoincrement())
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(REQUESTER)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  
  // Relations
  tickets            Ticket[]         @relation("TicketRequester")
  ownedTickets       Ticket[]         @relation("TicketOwner")
  publicComments     PublicComment[]
  internalNotes      InternalNote[]
}

// 2. Reference Data: Ticket Category
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  
  tickets   Ticket[]
}

// 3. Reference Data: Related System
model RelatedSystem {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
  
  tickets   Ticket[]
}

// Enums
enum Role {
  REQUESTER
  IT_STAFF
  ADMINISTRATOR
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum TicketStatus {
  New
  Open
  InProgress @map("In Progress")
  WaitingForRequester @map("Waiting for Requester")
  Resolved
  Closed
  Reopened
  Cancelled
}

// 4. Core Ticket Model
model Ticket {
  id                Int            @id @default(autoincrement())
  ticketNumber      String         @unique // Format: TKT-YYYY-NNNNNN
  summary           String         @db.VarChar(150)
  description       String         @db.VarChar(1000)
  requestedPriority TicketPriority
  itPriority        TicketPriority @default(LOW)
  currentStatus     TicketStatus   @default(New)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Foreign Keys & Relationships
  requesterId       Int
  ownerId           Int?
  categoryId        Int
  relatedSystemId   Int
  
  requester         User           @relation("TicketRequester", fields: [requesterId], references: [id])
  owner             User?          @relation("TicketOwner", fields: [ownerId], references: [id])
  category          Category       @relation(fields: [categoryId], references: [id])
  relatedSystem     RelatedSystem  @relation(fields: [relatedSystemId], references: [id])
  
  attachments       Attachment[]
  publicComments    PublicComment[]
  internalNotes     InternalNote[]

  @@index([requesterId])
  @@index([ownerId])
  @@index([categoryId])
  @@index([relatedSystemId])
  @@index([createdAt])
}

// 5. Attachment Model (Soft Removal enabled)
model Attachment {
  id            Int      @id @default(autoincrement())
  originalName  String
  filename      String   @unique // Safe generated name for storage
  mimeType      String
  size          Int      // Size in bytes (max 5MB)
  
  // Soft Removal Metadata
  isRemoved     Boolean  @default(false)
  removedReason String?
  
  createdAt     DateTime @default(now())
  
  ticketId      Int
  ticket        Ticket   @relation(fields: [ticketId], references: [id])

  @@index([ticketId])
}

// 6. Public Comment Model
model PublicComment {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])

  @@index([authorId])
  @@index([ticketId])
}

// 7. Internal Note Model
model InternalNote {
  id        Int      @id @default(autoincrement())
  content   String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])
  
  ticketId  Int
  ticket    Ticket   @relation(fields: [ticketId], references: [id])

  @@index([authorId])
  @@index([ticketId])
}
